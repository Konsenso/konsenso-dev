---
// Animated dot-field hero motif, ported from Konsenso Labs. Self-contained:
// draws a seeded, deterministic field that "grows" on scroll into view and
// respects prefers-reduced-motion.
interface Props {
  width?: number;
  height?: number;
}
const { width = 560, height = 440 } = Astro.props;
---

<canvas id="dot-canvas" width={width} height={height}></canvas>

<script>
  const canvas = document.getElementById("dot-canvas") as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const W = canvas.width;
    const H = canvas.height;
    const GAP = 15;
    const R = 3.1;
    const cols = Math.floor(W / GAP);
    const rows = Math.floor(H / GAP);
    const offX = (W - (cols - 1) * GAP) / 2;
    const offY = (H - (rows - 1) * GAP) / 2;

    let seed = 1337;
    const rand = () => {
      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
      return seed / 0x7fffffff;
    };

    type Dot = { x: number; y: number; color: string; base: number };
    const dots: Dot[] = [];

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const x = offX + c * GAP;
        const y = offY + r * GAP;
        const hill = Math.sin(c * 0.32) * 2.2 + Math.sin(c * 0.11 + 1) * 3.5;
        const ground = rows * 0.42 + hill;
        const below = r > ground;
        const density = below ? 0.94 : 0.14 + (r / rows) * 0.3;
        if (rand() > density) continue;
        let color: string;
        const roll = rand();
        if (below) color = roll < 0.4 ? "#004239" : roll < 0.68 ? "#009f60" : roll < 0.83 ? "#7adf9c" : roll < 0.92 ? "#0254ec" : "#ff78e1";
        else color = roll < 0.46 ? "#ffc300" : roll < 0.72 ? "#ffc8e5" : roll < 0.85 ? "#f46600" : roll < 0.93 ? "#ff78e1" : "#0254ec";
        dots.push({ x, y, color, base: R * (0.7 + rand() * 0.6) });
      }
    }

    const cx = W / 2, cy = H * 0.72;
    dots.sort((a, b) => Math.hypot(a.x - cx, a.y - cy) - Math.hypot(b.x - cx, b.y - cy));

    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const DURATION = 5200;
    const HOLD = 1400;
    const FADE = 900;
    let start = performance.now();
    let running = false;
    let rafId = 0;
    let lastDraw = 0;

    function loop(now: number) {
      if (document.hidden) { running = false; return; }
      if (now - lastDraw >= 33) { frame(now); lastDraw = now; }
      rafId = requestAnimationFrame(loop);
    }
    function play() {
      if (running || prefersReduced) return;
      running = true;
      rafId = requestAnimationFrame(loop);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(rafId);
    }
    function frame(now: number) {
      const cycle = DURATION + HOLD + FADE;
      const t = (now - start) % cycle;
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = "rgba(255,255,255,0.05)";
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          ctx.beginPath();
          ctx.arc(offX + c * GAP, offY + r * GAP, 0.8, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      const total = dots.length;
      dots.forEach((d, i) => {
        const appearAt = (i / total) * DURATION;
        let a: number;
        if (t < DURATION) a = Math.max(0, Math.min(1, (t - appearAt) / 420));
        else if (t < DURATION + HOLD) a = 1;
        else a = Math.max(0, 1 - (t - DURATION - HOLD) / FADE);
        if (a <= 0) return;
        const rad = d.base * (0.4 + 0.6 * a);
        ctx.globalAlpha = a;
        ctx.fillStyle = d.color;
        ctx.beginPath();
        ctx.arc(d.x, d.y, rad, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.globalAlpha = 1;
    }

    const savedStart = start;
    start = performance.now() - (DURATION + 200);
    frame(performance.now());
    start = savedStart;

    if (!prefersReduced) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting && !document.hidden) { start = performance.now(); play(); }
          else stop();
        },
        { threshold: 0.15 }
      );
      io.observe(canvas);
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden && !running) { start = performance.now(); play(); }
      });
    }
  }
</script>
